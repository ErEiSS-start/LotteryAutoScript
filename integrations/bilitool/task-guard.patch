+using System.Reflection;
+using System.Text.Json;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using Ray.BiliBiliTool.Agent;
+using Ray.BiliBiliTool.Agent.BiliBiliAgent.Dtos;
+using Ray.BiliBiliTool.Agent.BiliBiliAgent.Dtos.ApiApi.Video;
+using Ray.BiliBiliTool.Agent.BiliBiliAgent.Interfaces;
+using Ray.BiliBiliTool.Config.Options;
+using Ray.BiliBiliTool.DomainService;
+using Ray.BiliBiliTool.DomainService.Dtos;
+using Ray.BiliBiliTool.DomainService.Interfaces;
+using Ray.BiliBiliTool.Infrastructure;
+
+namespace Ray.BiliBiliTool.DomainService.UnitTests;
+
+public class StructuredTaskResultTests
+{
+    [Fact]
+    public async Task MockedInterfaces_ProduceFailuresAndWarningsWithoutRealInteractions()
+    {
+        string dir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
+        Directory.CreateDirectory(dir);
+        string file = Path.Combine(dir, "result.json");
+        Environment.SetEnvironmentVariable("TASK_GUARD_RESULT_PATH", file);
+        Assert.Equal(1, ConsoleTaskResult.Finish());
+        var ck = new BiliCookie(new Dictionary<string, string> { ["DedeUserID"] = "1", ["SESSDATA"] = "synthetic", ["bili_jct"] = "synthetic" });
+        var video = new VideoInfoDto { Aid = "123", Bvid = "BV1test", Title = "synthetic", Cid = 1, Duration = 15 };
+        foreach (var (uid, code, method) in new[] { ("1", -403, "share"), ("2", -412, "share"), ("3", -400, "watch") })
+        {
+            ConsoleTaskResult.Begin(uid);
+            var api = Proxy<IApiApi>.Make((_, _) => Task.FromResult(new BiliApiResponse { Code = code }));
+            var service = new VideoDomainService(NullLogger<VideoDomainService>.Instance, new OptionsMonitor<DailyTaskOptions>(new()), api);
+            if (method == "share") await service.ShareVideo(video, ck);
+            else await service.WatchVideo(video, ck);
+        }
+        foreach (var (uid, balance, failQuery) in new[] { ("4", 0m, false), ("5", 3m, false), ("6", 10m, true) })
+        {
+            ConsoleTaskResult.Begin(uid);
+            var coin = Proxy<ICoinDomainService>.Make((method, _) => method == "GetDonatedCoins"
+                ? failQuery ? Task.FromException<int>(new InvalidOperationException("synthetic")) : Task.FromResult(0)
+                : method == "GetCoinBalance" ? Task.FromResult(balance) : throw new Exception("Unexpected mock API"));
+            var service = new DonateCoinDomainService(NullLogger<DonateCoinDomainService>.Instance,
+                new OptionsMonitor<DailyTaskOptions>(new() { NumberOfCoins = 5, NumberOfProtectedCoins = 5 }), null!, coin, null!, null!);
+            await service.AddCoinsForVideos(ck);
+        }
+        ConsoleTaskResult.Begin("7");
+        ConsoleTaskResult.Fail("WATCH_FAILED", "watch");
+        ConsoleTaskResult.Pass("donate");
+        Assert.Equal(2, ConsoleTaskResult.Finish());
+        using var json = JsonDocument.Parse(File.ReadAllText(file));
+        var rows = json.RootElement.GetProperty("accounts").EnumerateArray().ToDictionary(r => r.GetProperty("account").GetString()!);
+        foreach (string uid in new[] { "1", "4", "5" }) Assert.Equal("success", rows[uid].GetProperty("status").GetString());
+        foreach (string uid in new[] { "2", "3", "6" }) Assert.Equal("failed", rows[uid].GetProperty("status").GetString());
+        Assert.Contains(rows["7"].GetProperty("passed").EnumerateArray(), p => p.GetString() == "donate");
+        Assert.Contains("SHARE_RESTRICTED", File.ReadAllText(file));
+        Assert.Contains("DONATE_FAILED", File.ReadAllText(file));
+        Assert.DoesNotContain("synthetic", File.ReadAllText(file));
+        Directory.Delete(dir, true);
+    }
+    public class Proxy<T> : DispatchProxy where T : class
+    {
+        public Func<string, object?[]?, object?> Handler = null!;
+        public static T Make(Func<string, object?[]?, object?> handler)
+        {
+            var result = Create<T, Proxy<T>>();
+            ((Proxy<T>)(object)result).Handler = handler;
+            return result;
+        }
+        protected override object? Invoke(MethodInfo? method, object?[]? args) => Handler(method!.Name, args);
+    }
+    private class OptionsMonitor<T>(T value) : IOptionsMonitor<T>
+    {
+        public T CurrentValue => value;
+        public T Get(string? name) => value;
+        public IDisposable? OnChange(Action<T, string?> listener) => null;
+    }
+}
