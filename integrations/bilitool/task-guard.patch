@@ -0,0 +1,90 @@
+using System.Text.Json;
+using Ray.BiliBiliTool.Application.Contracts;
+using Ray.BiliBiliTool.Domain;
+
+namespace Ray.BiliBiliTool.Infrastructure;
+
+// Opt-in Console result sink. Messages and credentials are deliberately excluded.
+public sealed class ConsoleTaskResult : ITaskRecordWriter
+{
+    private sealed record Failure(string Code, string Stage);
+    private sealed class Row
+    {
+        public string Account { get; set; } = "0";
+        public string Status { get; set; } = "success";
+        public List<Failure> Issues { get; } = [];
+        public List<string> Passed { get; } = [];
+        public List<string> Warnings { get; } = [];
+    }
+    private static readonly Dictionary<string, Row> Rows = [];
+    private static readonly List<object> GlobalIssues = [];
+    private static readonly AsyncLocal<Row?> Current = new();
+    private static readonly AsyncLocal<string?> StageValue = new();
+    private static readonly string? ResultPath = Environment.GetEnvironmentVariable("TASK_GUARD_RESULT_PATH");
+    private static readonly JsonSerializerOptions Options = new() { PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower };
+    public static bool Active => !string.IsNullOrEmpty(ResultPath);
+    public static void Begin(string uid)
+    {
+        if (!Active) return;
+        var row = new Row { Account = uid };
+        Rows[uid] = row;
+        Current.Value = row;
+        StageValue.Value = "login";
+        Save(false);
+    }
+    public static void Stage(string stage) { if (Active) StageValue.Value = stage; }
+    public static void Pass(string stage)
+    {
+        if (Current.Value is {} row && row.Issues.All(i => i.Stage != stage) && !row.Passed.Contains(stage)) row.Passed.Add(stage);
+        Save(false);
+    }
+    public static void Warn(string code)
+    {
+        if (Current.Value is {} row && !row.Warnings.Contains(code)) row.Warnings.Add(code);
+        Save(false);
+    }
+    public static void Fail(string? code = null, string? stage = null)
+    {
+        if (!Active || Current.Value is not {} row) return;
+        stage ??= StageValue.Value ?? "daily";
+        code ??= stage switch { "login" => "LOGIN_FAILED", "watch" => "WATCH_FAILED", "donate" => "DONATE_FAILED", _ => "DAILY_FAILED" };
+        row.Status = "failed";
+        var item = new Failure(code, stage);
+        if (!row.Issues.Contains(item)) row.Issues.Add(item);
+        row.Passed.Remove(stage);
+        Save(false);
+    }
+    private static void Save(bool complete)
+    {
+        if (!Active) return;
+        Directory.CreateDirectory(Path.GetDirectoryName(ResultPath!)!);
+        var json = JsonSerializer.Serialize(new { Version = 1, Complete = complete,
+            RunId = Environment.GetEnvironmentVariable("TASK_GUARD_RUN_ID"), Accounts = Rows.Values, Issues = GlobalIssues }, Options);
+        File.WriteAllText(ResultPath + ".tmp", json);
+        File.Move(ResultPath + ".tmp", ResultPath!, true);
+    }
+    public static int Finish()
+    {
+        if (!Active) return 0;
+        Save(true);
+        int failures = Rows.Values.Count(r => r.Status == "failed");
+        int code = GlobalIssues.Count > 0 || Rows.Count == 0 || failures == Rows.Count ? 1 : failures > 0 ? 2 : 0;
+        System.Console.WriteLine($"[每日升级结果] 账号 {Rows.Count}，失败 {failures}，退出码 {code}");
+        return code;
+    }
+    public static void Fatal()
+    {
+        GlobalIssues.Add(new { Code = Rows.Count == 0 ? "CONFIG_INVALID" : "UNCAUGHT_EXCEPTION", Stage = "startup" });
+        Save(true);
+    }
+    public Task WriteAsync(long userId, string taskKey, string? taskItemKey, TaskRecordStatus status,
+        string? message, TaskRecordTrigger trigger, CancellationToken cancellationToken = default)
+    {
+        if (taskKey == "DailyTaskAppService" && Current.Value is {} row)
+        {
+            if (status == TaskRecordStatus.Failed && row.Issues.Count == 0) Fail();
+            Save(false);
+        }
+        return Task.CompletedTask;
+    }
+}
